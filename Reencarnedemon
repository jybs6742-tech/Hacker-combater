--// =========================================================

local usandoImpulso = false
local emCooldown = false

slot.Activated:Connect(
	function()

		if usandoImpulso
			or emCooldown then

			return

		end

		local character =
			LocalPlayer.Character

		local humanoid =
			character
			and character:FindFirstChildOfClass(
				"Humanoid"
			)

		if not humanoid then
			return
		end

		usandoImpulso = true

		local velocidadeOriginal =
			humanoid.WalkSpeed

		local fim =
			os.clock() + 3

		while os.clock() < fim do

			if not humanoid.Parent then
				break
			end

			humanoid.WalkSpeed = 45

			RunService.Heartbeat:Wait()

		end

		if humanoid.Parent then

			humanoid.WalkSpeed =
				velocidadeOriginal

		end

		usandoImpulso = false
		emCooldown = true

		cooldown.Visible = true

		local fimCooldown =
			os.clock() + 6.7

		while os.clock() < fimCooldown do

			if not slot.Parent then
				return
			end

			local restante =
				math.max(
					0,
					fimCooldown -
					os.clock()
				)

			cooldown.Text =
				string.format(
					"%.1f",
					restante
				)

			RunService.Heartbeat:Wait()

		end

		cooldown.Visible = false
		emCooldown = false

	end
)

