local function UpdateDistance()

	local number =
		tonumber(
			DistanceBox.Text
		)

	if number and number > 0 then

		ORBIT_DISTANCE =
			number

	else

		ORBIT_DISTANCE =
			DEFAULT_ORBIT_DISTANCE

		DistanceBox.Text =
			tostring(
				DEFAULT_ORBIT_DISTANCE
			)

	end

end

DistanceBox.FocusLost:Connect(
	UpdateDistance
)

--// =========================================================
--// ESP
--// =========================================================

local function RemoveESP()

	if ESP then
		ESP:Destroy()
		ESP = nil
	end

end

local function GetTargetCharacter()

	if not selectedTarget then
		return nil
	end

	if targetIsNPC then
		return selectedTarget
	end

	return selectedTarget.Character

end

local function GetTargetRoot()

	local character =
		GetTargetCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChild(
		"HumanoidRootPart"
	)
	or character:FindFirstChild(
		"UpperTorso"
	)
	or character:FindFirstChild(
		"Torso"
	)

end

local function CreateESP(target)

	RemoveESP()

	if not target then
		return
	end

	local character

	if targetIsNPC then
		character = target
	else
		character = target.Character
	end

	if not character then
		return
	end

	local highlight =
		Instance.new("Highlight")

	highlight.Name =
		"SelectedTargetESP"

	highlight.Adornee =
		character

	highlight.FillColor =
		Color3.fromRGB(
			255,
			0,
			0
		)

	highlight.FillTransparency =
		0.5

	highlight.OutlineColor =
		Color3.fromRGB(
			255,
			0,
			0
		)

	highlight.OutlineTransparency = 0

	highlight.DepthMode =
		Enum.HighlightDepthMode.AlwaysOnTop

	highlight.Parent =
		character

	ESP = highlight

end

--// =========================================================
--// CÂMERA
--// =========================================================

local function RestoreLocalCamera()

	local Camera =
		workspace.CurrentCamera

	if not Camera then
		return
	end

	Camera.CameraType =
		Enum.CameraType.Custom

	local character =
		LocalPlayer.Character

	local humanoid =
		character
		and character:FindFirstChildOfClass(
			"Humanoid"
		)

	if humanoid then
		Camera.CameraSubject =
			humanoid
	end

end

local function ViewSelectedTarget()

	local Camera =
		workspace.CurrentCamera

	local character =
		GetTargetCharacter()

	if not Camera or not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if humanoid then

		Camera.CameraType =
			Enum.CameraType.Custom

		Camera.CameraSubject =
			humanoid

	end

end

--// =========================================================
--// MORTE DO ALVO
--// =========================================================

local function DisconnectTargetDeath()

	if targetDeathConnection then

		targetDeathConnection:Disconnect()
		targetDeathConnection = nil

	end

end

local ClearTarget

local function WatchTargetDeath(target)

	DisconnectTargetDeath()

	if not target then
		return
	end

	local humanoid

	if targetIsNPC then

		humanoid =
			target:FindFirstChildOfClass(
				"Humanoid"
			)

	else

		local character =
			target.Character

		humanoid =
			character
			and character:FindFirstChildOfClass(
				"Humanoid"
			)

	end

	if humanoid then

		targetDeathConnection =
			humanoid.Died:Connect(
				function()

					if not destroyed
						and selectedTarget == target then

						ClearTarget()

					end

				end
			)

	end

	if not targetIsNPC
		and target:IsA("Player") then

		targetDeathConnection =
			target.CharacterRemoving:Connect(
				function()

					if not destroyed
						and selectedTarget == target then

						ClearTarget()

					end

				end
			)

	end

end

--// =========================================================
--// LIMPAR ALVO
--// =========================================================

ClearTarget = function()

	orbiting = false
	lockOn = false
	autoTarget = false

	lastDirection = nil
	teleportTimer = 0
	lockOnBeforeOrbit = false

	DisconnectTargetDeath()
	RemoveESP()

	selectedTarget = nil
	targetIsNPC = false

	OrbitButton.Text =
		"Orbit: OFF"

	OrbitButton.BackgroundColor3 =
		OFF_COLOR

	LockButton.BackgroundColor3 =
		NORMAL_COLOR

	AutoButton.BackgroundColor3 =
		OFF_COLOR

	RestoreLocalCamera()

	if not destroyed then

		for _, button in ipairs(
			PlayerList:GetChildren()
		) do

			if button:IsA("TextButton") then

				button.TextColor3 =
					Color3.new(
						1,
						1,
						1
					)

			end

		end

	end

end

--// =========================================================
--// SELECIONAR ALVO
--// =========================================================

local function SelectTarget(
	target,
	isNPC
)

	if orbiting then
		return
	end

	if selectedTarget == target
		and targetIsNPC == isNPC then

		ClearTarget()
		return

	end

	selectedTarget = target
	targetIsNPC = isNPC

	autoTarget = false

	AutoButton.BackgroundColor3 =
		OFF_COLOR

	WatchTargetDeath(target)

	for _, button in ipairs(
		PlayerList:GetChildren()
	) do

		if button:IsA("TextButton") then

			local sameTarget

			if isNPC then

				sameTarget =
					button:GetAttribute(
						"NPCTarget"
					) == target

			else

				sameTarget =
					button:GetAttribute(
						"PlayerTarget"
					) == target.Name

			end

			button.TextColor3 =
				sameTarget
				and SELECTED_COLOR
				or Color3.new(
					1,
					1,
					1
				)

		end

	end

	CreateESP(target)

end

--// =========================================================
--// VERIFICAR NPC
--// =========================================================

local function IsNPC(model)

	if not model:IsA("Model") then
		return false
	end

	if Players:GetPlayerFromCharacter(
		model
	) then

		return false

	end

	return model:FindFirstChildOfClass(
		"Humanoid"
	) ~= nil

end

--// =========================================================
--// ATUALIZAR LISTA
--// =========================================================

local function UpdatePlayerList()

	if destroyed then
		return
	end

	for _, child in ipairs(
		PlayerList:GetChildren()
	) do

		if child:IsA("TextButton") then
			child:Destroy()
		end

	end

	Title.Text =
		showingNPCs
		and "NPCs"
		or "Orbit"

	NPCButton.BackgroundColor3 =
		showingNPCs
		and LOCK_COLOR
		or NORMAL_COLOR

	local targets = {}

	if showingNPCs then

		for _, object in ipairs(
			workspace:GetDescendants()
		) do

			if IsNPC(object) then

				table.insert(
					targets,
					object
				)

			end

		end

	else

		for _, player in ipairs(
			Players:GetPlayers()
		) do

			if player ~= LocalPlayer then

				table.insert(
					targets,
					player
				)

			end

		end

	end

	table.sort(
		targets,
		function(a, b)

			return a.Name:lower()
				<
				b.Name:lower()

		end
	)

	for _, target in ipairs(
		targets
	) do

		local Button =
			Instance.new("TextButton")

		Button.Size =
			UDim2.new(
				1,
				-8,
				0,
				30
			)

		Button.BackgroundColor3 =
			NORMAL_COLOR

		Button.BackgroundTransparency =
			0.05

		Button.BorderSizePixel = 0

		Button.Text =
			target.Name

		Button.TextColor3 =
			(
				selectedTarget == target
				and targetIsNPC == showingNPCs
			)
			and SELECTED_COLOR
			or Color3.new(
				1,
				1,
				1
			)

		Button.TextSize = 13
		Button.Font =
			Enum.Font.Gotham

		Button.ZIndex = 12

		if showingNPCs then

			Button:SetAttribute(
				"NPCTarget",
				target
			)

		else

			Button:SetAttribute(
				"PlayerTarget",
				target.Name
			)

		end

		Button.Parent =
			PlayerList

		Button.Activated:Connect(
			function()

				SelectTarget(
					target,
					showingNPCs
				)

			end
		)

	end

	task.defer(
		function()

			if not destroyed then

				PlayerList.CanvasSize =
					UDim2.new(
						0,
						0,
						0,
						UIListLayout
							.AbsoluteContentSize.Y
							+ 5
					)

			end

		end
	)

end

--// =========================================================
--// PARAR ORBIT
--// =========================================================

local function StopOrbit()

	orbiting = false

	lastDirection = nil
	teleportTimer = 0

	OrbitButton.Text =
		"Orbit: OFF"

	OrbitButton.BackgroundColor3 =
		OFF_COLOR

	if lockOnBeforeOrbit
		and selectedTarget then

		lockOn = true

		LockButton.BackgroundColor3 =
			LOCK_COLOR

	else

		lockOn = false

		LockButton.BackgroundColor3 =
			NORMAL_COLOR

	end

	RestoreLocalCamera()

end

--// =========================================================
--// INICIAR ORBIT
--// =========================================================

local function StartOrbit()

	if not selectedTarget then

		OrbitButton.Text =
			"Selecione alguém!"

		task.delay(
			1,
			function()

				if not destroyed
					and not orbiting then

					OrbitButton.Text =
						"Orbit: OFF"

				end

			end
		)

		return

	end

	if not GetTargetRoot() then

		ClearTarget()
		return

	end

	UpdateDistance()

	lockOnBeforeOrbit =
		lockOn

	lockOn = false

	LockButton.BackgroundColor3 =
		OFF_COLOR

	orbiting = true

	lastDirection = nil
	teleportTimer = 0

	OrbitButton.Text =
		"Orbit: ON"

	OrbitButton.BackgroundColor3 =
		ON_COLOR

	ViewSelectedTarget()

end

--// =========================================================
--// BOTÃO ORBIT
--// =========================================================

OrbitButton.Activated:Connect(
	function()

		if orbiting then
			StopOrbit()
		else
			StartOrbit()
		end

	end
)

