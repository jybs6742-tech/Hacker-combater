local function WatchPlayer(player)

	if player == LocalPlayer then
		return
	end

	player.CharacterAdded:Connect(
		function(character)

			if _G.__OrbitImpulsoRunToken
				~= RunToken
				or destroyed then

				return

			end

			task.wait(0.1)

			if selectedTarget == player
				and not targetIsNPC then

				ClearTarget()

			end

			local humanoid =
				character:FindFirstChildOfClass(
					"Humanoid"
				)

			if humanoid then

				humanoid.Died:Connect(
					function()

						if not destroyed
							and selectedTarget == player
							and not targetIsNPC then

							ClearTarget()

						end

					end
				)

			end

		end
	)

	player.CharacterRemoving:Connect(
		function()

			if not destroyed
				and selectedTarget == player
				and not targetIsNPC then

				ClearTarget()

			end

		end
	)

end

for _, player in ipairs(
	Players:GetPlayers()
) do

	WatchPlayer(player)

end

Players.PlayerAdded:Connect(
	function(player)

		WatchPlayer(player)

		task.wait(0.2)

		if not destroyed
			and not showingNPCs then

			UpdatePlayerList()

		end

	end
)

Players.PlayerRemoving:Connect(
	function(player)

